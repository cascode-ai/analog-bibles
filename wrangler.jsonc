{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "analog-bibles",
  "main": "./site/worker.js",
  "compatibility_date": "2025-06-01",
  "workers_dev": true,
  "routes": [{ "pattern": "analog-bibles.tokenzhang.com", "custom_domain": true }],
  // dist/ is written by `node site/build.mjs`: the page plus every question's files.
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "analog-bibles",
      "database_id": "bfcf6a80-729b-4f8f-9fa9-fc377e9bd2bb"
    }
  ]
}
