{
  "name": "analog-bibles",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build && node --test site/reading.test.mjs",
    "build": "node site/build.mjs",
    "dev": "node site/build.mjs && wrangler dev",
    "db:init": "wrangler d1 execute analog-bibles --remote --file site/schema.sql",
    "deploy": "node site/build.mjs && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.163.0"
  }
}
